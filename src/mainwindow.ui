  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #2B2A35,
        stop:1 #1C1B24
    );
}

QWidget#centralwidget {
    background-color: transparent;
}
QGroupBox {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #404050, stop:0.5 #2c2b35, stop:1 #0a0a0a);
    border: 2px solid #363540;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
    color: white;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ff88, stop:1 #00cc66);
}
QComboBox {
    background: #2f2f2f;
    border-radius: 8px;
    border: 1px solid #3a3a3a;
    padding: 2px 8px;
    color: white;
    font-size: 10px;
}

QComboBox:hover {
    border: 1px solid #00ff88;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #2a2a2a;
    border: 1px solid #00ff88;
    selection-background-color: #00ff88;
    selection-color: #000000;
    color: white;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border: none;
    color: white;
    font-size: 10px;
}

QComboBox QAbstractItemView::item:hover {
    background: #363540;
    color: #00ff88;
}

QComboBox QAbstractItemView::item:selected {
    background: #00ff88;
    color: #000000;
}

/* Modern scrollbar for QComboBox */
QComboBox QAbstractItemView QScrollBar:vertical {
    border: none;
    background: #2a2a2a;
    width: 12px;
    margin: 0px;
}

QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a4a4a, stop:1 #2a2a2a);
    min-height: 20px;
    border-radius: 6px;
    border: 1px solid #363540;
}

QComboBox QAbstractItemView QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #00ff88, stop:1 #00cc66);
    border: 1px solid #00ff88;
}

QComboBox QAbstractItemView QScrollBar::add-line:vertical,
QComboBox QAbstractItemView QScrollBar::sub-line:vertical {
    height: 0px;
}

QComboBox QAbstractItemView QScrollBar::add-page:vertical,
QComboBox QAbstractItemView QScrollBar::sub-page:vertical {
    background: none;
}
QListWidget {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #4a4a5a, stop:0.5 #2c2b35, stop:1 #0a0a0a);
    border: 2px solid #363540;
    border-radius: 6px;
    color: white;
    font-size: 12px;
}
QListWidget::item {
    padding: 5px;
    border-bottom: 1px solid #363540;
}
QListWidget::item:selected {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #7a7aff, stop:0.5 #6a6aff, stop:1 #3a3a5a);
}

/* === SLIDER GENEL === */
QSlider {
    min-height: 24px;
}

/* === GROOVE (ARKA Ã‡UBUK) === */
QSlider::groove:horizontal {
    height: 6px;
    background: #2A2D3A;
    border-radius: 3px;
}

/* === SUB-PAGE (DOLU KISIM) === */
QSlider::sub-page:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #006400,
        stop:1 #00ff88
    );
    border-radius: 3px;
}

/* === ADD-PAGE (BOÅ KISIM) === */
QSlider::add-page:horizontal {
    background: #1E202C;
    border-radius: 3px;
}

/* === HANDLE (TOPUZ) === */
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4a4a4a,
        stop:1 #2a2a2a
    );
}

/* === HOVER EFFECT === */
QSlider::handle:horizontal:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #006400,
        stop:1 #00ff88
    );
}

/* === DISABLED === */
QSlider::handle:horizontal:disabled {
    background: #555;
}

QProgressBar {
    border: 2px solid #363540;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
    color: white;
    background: qradialgradient(
        cx: 0.5, cy: 0.5,
        radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 #2a2a35,
        stop: 0.5 #1c1b25,
        stop: 1 #050505
    );
}

QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #00ff88,
        stop: 0.5 #00cc6a,
        stop: 1 #00aa55
    );
    border: 1px solid #00ff88;
}
