   <property name="styleSheet">
    <string notr="true">QMainWindow {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: &quot;Segoe UI&quot;;
    font-size: 9pt;
}

QWidget {
    background: transparent;
    color: #e0e0e0;
}

/* ================================
   FRAME / CARD
================================ */
QFrame {
    background: #252525;
    border-radius: 12px;
    padding: 6px;
}

QFrame[class=&quot;card&quot;] {
    background: #2b2b2b;
    border-radius: 14px;
}

/* ================================
   LABELS
================================ */
QLabel {
    color: #e0e0e0;
}

QLabel[class=&quot;title&quot;] {
    color: #00ff88;
    font-size: 14pt;
    font-weight: bold;
}

QLabel[class=&quot;panelTitle&quot;] {
    color: #00ff88;
    font-size: 11pt;
    font-weight: bold;
    border-bottom: 1px solid #3a3a3a;
    padding-bottom: 4px;
    margin-bottom: 6px;
}

/* ================================
   SCROLLBAR (MINIMAL)
================================ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #00ff88;
    border-radius: 3px;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
}

/* ================================
   BUTTONS (BASE)
================================ */
QPushButton {
    background: #2f2f2f;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    color: #ffffff;
    padding: 4px 10px;
}

QPushButton:hover {
    background: #3a3a3a;
    border: 1px solid #00ff88;
}

QPushButton:pressed {
    background: #1f1f1f;
}

/* ================================
   SOUND GRID BUTTONS
================================ */
QPushButton[class=&quot;soundButton&quot;] {
    background: #2a2a2a;
    border-radius: 10px;
    min-width: 58px;
    max-width: 58px;
    min-height: 44px;
    max-height: 44px;
    font-size: 7pt;
}

QPushButton[class=&quot;soundButton&quot;]:hover {
    background: #353535;
    border: 1px solid #00ff88;
}

/* ================================
   EFFECT / ACCENT BUTTONS
================================ */
QPushButton[class=&quot;effectButton&quot;] {
    background: #ff6b35;
    border-radius: 10px;
    padding: 4px 12px;
    font-weight: bold;
}

QPushButton[class=&quot;effectButton&quot;]:hover {
    background: #ff855c;
}

QPushButton[class=&quot;effectButton&quot;]:checked {
    background: #00ff88;
    color: #000000;
}

/* ================================
   COMBOBOX
================================ */
QComboBox {
    background: #2f2f2f;
    border-radius: 8px;
    border: 1px solid #3a3a3a;
    padding: 2px 8px;
}

QComboBox:hover {
    border: 1px solid #00ff88;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #2a2a2a;
    border: 1px solid #00ff88;
    selection-background-color: #00ff88;
    selection-color: #000000;
}

/* ================================
   SLIDER
================================ */
QSlider::groove:horizontal {
    height: 4px;
    background: #3a3a3a;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #00ff88;
    border-radius: 7px;
}

/* ================================
   PROGRESS BAR
================================ */
QProgressBar {
    background: #2a2a2a;
    border-radius: 8px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background: #00ff88;
    border-radius: 8px;
}</string>
